{
  "name": "wardforward",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute wardforward-db --local --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute wardforward-db --local --file=./db/seed-m44.sql",
    "db:seed:solutions:local": "wrangler d1 execute wardforward-db --local --file=./db/seed-solutions.sql",
    "db:seed:start-here:local": "wrangler d1 execute wardforward-db --local --file=./db/seed-start-here.sql",
    "db:reset:local": "npm run db:init:local && npm run db:seed:local",
    "test": "vitest run",
    "test:equiv": "vitest run --config vitest.equiv.config.ts",
    "seed:start-here": "node scripts/build-start-here-seed.mjs",
    "seed:start-here:check": "node scripts/build-start-here-seed.mjs --check"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "^5.20260710.1",
    "typescript": "^5.7.0",
    "vitest": "5.1.0",
    "wrangler": "^4.111.0"
  }
}
